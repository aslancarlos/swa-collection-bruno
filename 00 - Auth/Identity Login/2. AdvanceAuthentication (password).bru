meta {
  name: 2. AdvanceAuthentication (password)
  type: http
  seq: 3
}

post {
  url: {{IDENTITY_POD_URL}}/Security/AdvanceAuthentication
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-IDAP-NATIVE-CLIENT: true
  Authorization:
}

body:json {
  {
    "SessionId": "{{SESSION_ID}}",
    "MechanismId": "{{PWD_MECH}}",
    "Action": "Answer",
    "Answer": "{{IDENTITY_PASSWORD}}"
  }
}

script:post-response {
  const r = (res.getBody() && res.getBody().Result) || {};
  if (r.Summary === 'LoginSuccess' && (r.Token || r.AuthData)) {
    bru.setEnvVar('IDENTITY_JWT', r.Token || r.AuthData);   // no MFA: the token comes right away
  } else {
    const chs = r.Challenges || [];
    if (chs[1]) (chs[1].Mechanisms || []).forEach(function(m){
      if (m.Enrolled) bru.setEnvVar('MFA_MECH', m.MechanismId);
    });
  }
}

docs {
  # 2. AdvanceAuthentication (password)

  Sends the password (env secret **IDENTITY_PASSWORD**). If there is no MFA, it writes
  **IDENTITY_JWT** right away. Otherwise, it writes **MFA_MECH** (the 1st enrolled mechanism) for step 3/4.
}
