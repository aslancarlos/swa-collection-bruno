meta {
  name: 13. Get Secret api-key
  type: http
  seq: 13
}

get {
  url: {{SWA_API_BASE}}/api/secrets/conjur/variable/{{SECRET_ID}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  # 13. Get Secret api-key

  GET /api/secrets/conjur/variable/{{SECRET_ID}}

  Uses the {{TOKEN}} obtained in step 12 (collection header) to read the secret.
  Full flow validated: SVID -> authenticate -> secret = example-secret-value.
}
