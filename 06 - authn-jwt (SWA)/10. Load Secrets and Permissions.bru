meta {
  name: 10. Load Secrets and Permissions
  type: http
  seq: 10
}

post {
  url: {{SWA_API_BASE}}/api/policies/conjur/policy/data
  body: text
  auth: none
}

headers {
  Content-Type: text/yaml
}

body:text {
  - !policy
    id: swa/secrets
    body:
      - !policy
        id: myapp
        body:
          - !variable
            id: api-key
          - !permit
            role: !host /data/swa/trust-domains/example.machineid/workloads/spiffe://example.machineid/k8s-prod-ng/ns/conjur/sa/conjur-sa-swa
            privilege: [ read, execute ]
            resource: !variable api-key
          - !permit
            role: !host /data/swa/trust-domains/example.machineid/workloads/spiffe://example.machineid/k8s-prod-ng/ns/swa-clients/sa/swa-id-sa
            privilege: [ read, execute ]
            resource: !variable api-key
}

docs {
  # 10. Load Secrets and Permissions

  POST .../policy/data

  Creates data/swa/secrets/myapp/api-key and grants read/execute to the 2 workloads
  (absolute reference /data/.../workloads/<spiffe-id>).
}
