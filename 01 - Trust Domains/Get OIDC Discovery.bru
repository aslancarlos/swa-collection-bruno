  type: http
  seq: 5
}

get {
  url: {{SWA_API_BASE}}/api/swa/trust-domains/{{TRUST_DOMAIN_NAME}}/.well-known/openid-configuration
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  # Get OIDC Discovery (trust domain)

  GET /api/swa/trust-domains/{trust-domain-name}/.well-known/openid-configuration

  OIDC discovery document for the trust domain (issuer, jwks_uri, algorithms).
  One of the `discovery_endpoints` returned when the trust domain is created. Public.
}
